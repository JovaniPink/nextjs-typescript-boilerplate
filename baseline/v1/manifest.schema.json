{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JovaniPink/nextjs-typescript-boilerplate/blob/main/baseline/v1/manifest.schema.json",
  "title": "Next.js fleet baseline manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineVersion",
    "profile",
    "projectRoot",
    "nextApps",
    "exceptions"
  ],
  "properties": {
    "schemaVersion": { "const": "nextjs-baseline.manifest.v1" },
    "baselineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profile": {
      "enum": ["stock-static", "stock-server", "monorepo-hybrid", "vinext"]
    },
    "projectRoot": { "$ref": "#/$defs/safePath" },
    "nextApps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safePath" }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "reason", "issueUrl", "reviewAfter"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 12, "maxLength": 500 },
          "issueUrl": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/[1-9][0-9]*$"
          },
          "reviewAfter": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?:\\.|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
    }
  }
}
