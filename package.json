{
  "name": "nextjs-typescript-boilerplate",
  "version": "1.0.0",
  "description": "A production-minded Next.js and TypeScript starter with a complete local and CI quality gate.",
  "private": true,
  "license": "MIT",
  "author": "Jovani Pink",
  "repository": {
    "type": "git",
    "url": "https://github.com/JovaniPink/nextjs-typescript-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/JovaniPink/nextjs-typescript-boilerplate/issues"
  },
  "homepage": "https://github.com/JovaniPink/nextjs-typescript-boilerplate#readme",
  "keywords": [
    "nextjs",
    "react",
    "starter",
    "tailwindcss",
    "typescript"
  ],
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "toolchain:check": "node scripts/typescript-toolchain-check.mjs",
    "typecheck": "next typegen && node node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:compat": "next typegen && node node_modules/typescript/bin/tsc --noEmit",
    "test": "jest --watchman=false",
    "test:watch": "jest --watch --watchman=false",
    "test:ci": "jest --runInBand --coverage --watchman=false",
    "test-all": "npm run format:check && npm run lint && npm run toolchain:check && npm run typecheck && npm run typecheck:compat && npm run test:ci && npm run build",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:dependencies": "npm audit --audit-level=high",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lint-staged": "17.3.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": "prettier --write"
  }
}
