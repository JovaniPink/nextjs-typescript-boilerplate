{
  "title": "",
  "name": "nextjs-typescript-boilerplate",
  "description": "A TypeScript starter for NextJS. No plugins and styling. Exactly the necessary to start.",
  "keywords": [
    "react",
    "nextjs",
    "nextjs-starter",
    "typescript"
  ],
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JovaniPink/nextjs-typescript-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/JovaniPink/nextjs-typescript-boilerplate/issues"
  },
  "homepage": "https://github.com/JovaniPink/nextjs-typescript-boilerplate#readme",
  "author": "",
  "contributors": [
    ""
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test-all": "npm run lint && npm run type-check && npm test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
